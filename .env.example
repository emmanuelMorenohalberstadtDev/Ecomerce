# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored — never commit it. This file IS committed and must stay complete.
# Every variable here is required; a missing variable fails container startup loudly.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL username (created on first db container start)
DB_USER=ecommerce

# PostgreSQL password — use a strong random value in any shared environment
DB_PASSWORD=CHANGE_ME

# PostgreSQL database name
DB_NAME=ecommerce_prod

# JDBC URL used by the api container — uses the 'db' service name as hostname
DB_URL=jdbc:postgresql://db:5432/ecommerce_prod

# ── Security ──────────────────────────────────────────────────────────────────
# JWT signing key — must be at least 256 bits (32+ random bytes, base64-encoded)
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_256_bits

# ── Spring ────────────────────────────────────────────────────────────────────
# Active Spring profile — use 'dev' for local development (verbose logging)
SPRING_PROFILES_ACTIVE=default
