# Exclude everything that must not enter the build context.
# Build tools, secrets, and ephemeral outputs are never sent to the Docker daemon.

target/
*.class
*.jar

# Local IDE / OS artifacts
.idea/
*.iml
.DS_Store
Thumbs.db

# Environment files — secrets never enter images
.env
*.env.local

# Git history is not needed inside the build context
.git/
.gitignore
